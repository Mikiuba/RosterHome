{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rosterhome",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/calendar/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALENDAR_STORE",
        "class_name": "CalendarStore"
      }
    ]
  },
  "exports": {
    "CalendarStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "17 4 * * *"
    ]
  }
}
